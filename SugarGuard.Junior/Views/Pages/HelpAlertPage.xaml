<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SugarGuard.Junior.Views.Pages.HelpAlertPage"
             Title=""
             BackgroundColor="{DynamicResource BackgroundPage}"
             Shell.NavBarIsVisible="False">

    <ScrollView VerticalScrollBarVisibility="Never">
        <Grid Padding="{StaticResource Spacing24}"
              RowDefinitions="Auto,Auto,Auto,Auto"
              RowSpacing="{StaticResource Spacing16}">

            <VerticalStackLayout Grid.Row="0"
                                 Spacing="{StaticResource Spacing8}"
                                 HorizontalOptions="Fill">
                <Label Text="SOS и помощь"
                       FontFamily="ClashDisplay"
                       FontSize="32"
                       FontAttributes="Bold"
                       TextColor="{DynamicResource TextPrimary}"
                       HorizontalTextAlignment="Start" />
            </VerticalStackLayout>

            <Border Grid.Row="1"
                    BackgroundColor="{DynamicResource Surface}"
                    Stroke="{DynamicResource BorderDefault}"
                    StrokeThickness="1"
                    StrokeShape="RoundRectangle 24"
                    Padding="{StaticResource Spacing24}">

                <VerticalStackLayout Spacing="{StaticResource Spacing12}">
                    <Label Text="Рекомендация"
                           FontFamily="Satoshi"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="{DynamicResource TextPrimary}" />
                    <Label Text="{Binding SnackAdviceHint}"
                           FontFamily="Satoshi"
                           FontSize="15"
                           TextColor="{DynamicResource TextSecondary}"
                           LineBreakMode="WordWrap" />
                    <Button Text="Получить рекомендацию"
                            Command="{Binding GetSnackAdviceCommand}"
                            BackgroundColor="{DynamicResource BrandPrimary}"
                            TextColor="White"
                            FontFamily="Satoshi"
                            FontSize="17"
                            FontAttributes="Bold"
                            HeightRequest="56"
                            CornerRadius="22"
                            IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                </VerticalStackLayout>
            </Border>

            <VerticalStackLayout Grid.Row="2" Spacing="{StaticResource Spacing12}">
                <Button Text="Позвонить родителю"
                        Command="{Binding CallParentCommand}"
                        BackgroundColor="{DynamicResource BrandPrimary}"
                        TextColor="White"
                        FontFamily="Satoshi"
                        FontSize="18"
                        FontAttributes="Bold"
                        HeightRequest="64"
                        CornerRadius="24"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Text="Позвонить резервному"
                        Command="{Binding CallBackupParentCommand}"
                        Style="{StaticResource SecondaryButton}"
                        HeightRequest="48"
                        IsVisible="{Binding HasBackupParentPhone}"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
                <Button Text="Вызвать скорую (112)"
                        Command="{Binding CallEmergencyCommand}"
                        BackgroundColor="{DynamicResource GlucoseDangerColor}"
                        TextColor="White"
                        FontFamily="Satoshi"
                        FontSize="18"
                        FontAttributes="Bold"
                        HeightRequest="64"
                        CornerRadius="24"
                        IsEnabled="{Binding IsLoading, Converter={StaticResource InvertedBoolConverter}}" />
            </VerticalStackLayout>

            <!-- Индикатор загрузки -->
            <ActivityIndicator Grid.Row="3"
                               IsRunning="{Binding IsLoading}"
                               IsVisible="{Binding IsLoading}"
                               Color="{DynamicResource BrandPrimary}"
                               HorizontalOptions="Center" />

        </Grid>
    </ScrollView>
</ContentPage>
