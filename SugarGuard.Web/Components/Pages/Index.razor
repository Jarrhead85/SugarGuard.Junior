@code {
    private bool isDarkTheme;
    private string activeAudienceId = "parent";

    private string LandingClass => isDarkTheme ? "sg-landing sg-landing--dark" : "sg-landing";

    private AudienceCard ActiveAudience =>
        Audiences.First(audience => audience.Id == activeAudienceId);

    private static readonly AudienceCard[] Audiences =
    [
        new(
            "parent",
            "01",
            "Родителям",
            "Спокойнее видеть целый день",
            "Не теряйте важные события между звонками и сообщениями",
            "В кабинете родителя измерения, питание, тревоги и врачебные заметки собраны вокруг конкретного ребёнка.",
            ["Текущая глюкоза и история", "Уведомления и SOS-события", "Рюкзак, питание и экспорт отчётов"],
            "Создать аккаунт родителя",
            "/register",
            "Кабинет родителя",
            "За последние 7 дней",
            "82%",
            "в целевом диапазоне за 7 дней"),
        new(
            "doctor",
            "02",
            "Врачам",
            "Картина по пациенту без ручного сбора",
            "Сосредоточьтесь на динамике и пациентах, которым нужно внимание",
            "Врач получает доступ только после подключения к ребёнку и работает в отдельном клиническом кабинете.",
            ["Список пациентов и группы риска", "Графики, TIR и аналитика", "Заметки и экспорт данных"],
            "Зарегистрироваться как врач",
            "/register",
            "Мои пациенты",
            "Требуют внимания",
            "2",
            "пациента требуют внимания"),
        new(
            "admin",
            "03",
            "Администраторам",
            "Прозрачность ролей и действий",
            "Управляйте доступами без общих паролей и неясных полномочий",
            "Административный контур отделён от медицинской работы и помогает контролировать пользователей, заявки и состояние системы.",
            ["Роли и подтверждение врачей", "Аудит действий и журнал синхронизации", "Мониторинг сервисов и поддержка"],
            "Посмотреть вход в систему",
            "/login",
            "Системная панель",
            "Состояние сервисов",
            "Все системы",
            "работают штатно")
    ];

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                var role = user.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value
                           ?? user.FindFirst("role")?.Value;

                var target = role switch
                {
                    "Admin" or "SupportAdmin" => "/admin/dashboard",
                    "Doctor" => "/doctor/dashboard",
                    _ => "/parent/dashboard"
                };

                Navigation.NavigateTo(target, replace: true);
                return;
            }
        }
        catch (Exception exception)
        {
            Logger.LogWarning(exception, "Не удалось проверить авторизацию на публичном лендинге");
        }

        try
        {
            var theme = await JS.InvokeAsync<string>("sugarGuardTheme.getTheme");
            isDarkTheme = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
            StateHasChanged();
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, "Не удалось прочитать сохранённую тему лендинга");
        }
    }

    private void SelectAudience(string audienceId)
    {
        if (Audiences.Any(audience => audience.Id == audienceId))
        {
            activeAudienceId = audienceId;
        }
    }

    private string AudienceTabClass(string audienceId) =>
        activeAudienceId == audienceId ? "sg-audience-tab is-active" : "sg-audience-tab";

    private async Task ToggleThemeAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("sugarGuardTheme.toggle");
            var theme = await JS.InvokeAsync<string>("sugarGuardTheme.getTheme");
            isDarkTheme = string.Equals(theme, "dark", StringComparison.OrdinalIgnoreCase);
        }
        catch (JSException exception)
        {
            Logger.LogDebug(exception, "Не удалось переключить сохранённую тему лендинга");
            isDarkTheme = !isDarkTheme;
        }
    }

    private sealed record AudienceCard(
        string Id,
        string Number,
        string Label,
        string Eyebrow,
        string Title,
        string Description,
        string[] Benefits,
        string CtaLabel,
        string CtaHref,
        string PreviewLabel,
        string PreviewTitle,
        string PreviewMetric,
        string PreviewCaption);
}
