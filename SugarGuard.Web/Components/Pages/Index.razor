@page "/"
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization

@attribute [AllowAnonymous]
@layout EmptyLayout

@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Navigation
@inject IJSRuntime JS
@inject ILogger<Index> Logger

<PageTitle>SugarGuard — диабет ребёнка под совместным контролем</PageTitle>
<HeadContent>
    <meta name="description"
          content="SugarGuard объединяет измерения глюкозы, питание, подсказки, уведомления и наблюдение врача в Android-приложении и веб-кабинете." />
    <meta name="theme-color" content="#0f8f8a" />
    <link rel="canonical" href="https://sugar-guard.ru/" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ru_RU" />
    <meta property="og:title" content="SugarGuard — диабет ребёнка под совместным контролем" />
    <meta property="og:description" content="Глюкоза, питание, отчёты и информационные подсказки — в Android-приложении и веб-кабинетах для семьи и врача." />
    <meta property="og:url" content="https://sugar-guard.ru/" />
</HeadContent>

<div class="@LandingClass">
    <a class="sg-landing__skip-link" href="#main-content">Перейти к содержанию</a>

    <header class="sg-landing__header">
        <div class="sg-landing__container sg-landing__header-inner">
            <a class="sg-landing__brand" href="/" aria-label="SugarGuard — на главную">
                <span class="sg-landing__logo" aria-hidden="true">
                    <img src="/images/sugarguard-mark.svg" alt="" width="44" height="44" />
                </span>
                <span>
                    <strong>SugarGuard</strong>
                    <small>Рядом, когда это важно</small>
                </span>
            </a>

            <nav class="sg-landing__main-nav" aria-label="Разделы страницы">
                <a href="#audiences">Для кого</a>
                <a href="#how-it-works">Как работает</a>
                <a href="#interface">Интерфейс</a>
                <a href="#trust">Безопасность</a>
                <a href="#faq">FAQ</a>
            </nav>

            <div class="sg-landing__header-actions">
                <button class="sg-icon-button"
                        type="button"
                        @onclick="ToggleThemeAsync"
                        aria-label="@(isDarkTheme ? "Включить светлую тему" : "Включить тёмную тему")"
                        aria-pressed="@isDarkTheme"
                        title="@(isDarkTheme ? "Включить светлую тему" : "Включить тёмную тему")">
                    @if (isDarkTheme)
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <circle cx="12" cy="12" r="4" />
                            <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41" />
                        </svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M21 12.8A8.5 8.5 0 1 1 11.2 3 6.6 6.6 0 0 0 21 12.8Z" />
                        </svg>
                    }
                </button>
                <a class="sg-link-button sg-link-button--quiet" href="/login">Войти</a>
                <a class="sg-link-button sg-link-button--header" href="/downloads/android">Скачать приложение</a>
            </div>
        </div>
    </header>

    <main id="main-content">
        <section class="sg-landing__hero" aria-labelledby="hero-title">
            <div class="sg-landing__container sg-landing__hero-grid">
                <div class="sg-landing__hero-copy">
                    <div class="sg-landing__status-row">
                        <span class="sg-status-badge">
                            <span class="sg-status-badge__dot" aria-hidden="true"></span>
                            Открытая пилотная версия
                        </span>
                        <span class="sg-platform-badge">Android + Web</span>
                    </div>

                    <h1 id="hero-title">Диабет ребёнка — под совместным контролем семьи и врача</h1>
                    <p class="sg-landing__hero-lead">
                        Глюкоза, питание, тревожные события, заметки врача и понятные подсказки —
                        в мобильном приложении ребёнка и связанных веб-кабинетах.
                    </p>

                    <div class="sg-landing__hero-actions">
                        <a class="sg-cta sg-cta--primary" href="/downloads/android">
                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                <path d="M12 3v12m0 0 4-4m-4 4-4-4M5 20h14" />
                            </svg>
                            Скачать APK
                        </a>
                        <a class="sg-cta sg-cta--secondary" href="#how-it-works">Посмотреть, как это работает</a>
                    </div>
                    <p class="sg-landing__account-link">
                        Уже используете SugarGuard? <a href="/login">Войти в кабинет</a>
                        <span aria-hidden="true">·</span>
                        <a href="/register">Создать аккаунт</a>
                    </p>

                    <ul class="sg-landing__proof-list" role="list">
                        <li>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                            Офлайн после первого онлайн-входа
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                            SOS с глюкозой и геопозицией
                        </li>
                        <li>
                            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                            Управляемый доступ родителей и врача
                        </li>
                    </ul>
                </div>

                <div class="sg-product-stage" aria-hidden="true">
                    <div class="sg-product-stage__glow"></div>
                    <div class="sg-phone-mockup">
                        <div class="sg-phone-mockup__bar">
                            <span>9:41</span>
                            <span>● ● ▰</span>
                        </div>
                        <div class="sg-phone-mockup__hello">Привет, Тимофей!</div>
                        <div class="sg-phone-mockup__glucose">
                            <span class="sg-phone-mockup__drop">
                                <svg viewBox="0 0 24 24"><path d="M12 2S5.5 9.4 5.5 14.4a6.5 6.5 0 1 0 13 0C18.5 9.4 12 2 12 2Z" /></svg>
                            </span>
                            <div><strong>5,8</strong><small>ммоль/л</small></div>
                            <span class="sg-ui-pill sg-ui-pill--ok">В норме</span>
                        </div>
                        <div class="sg-phone-mockup__chart">
                            <span class="sg-phone-mockup__range"></span>
                            <svg viewBox="0 0 320 100" preserveAspectRatio="none">
                                <path class="sg-chart-line" d="M4 69 C34 62, 52 73, 82 61 S132 40, 164 51 S216 69, 244 44 S286 30, 316 36" />
                                <g class="sg-chart-points">
                                    <circle cx="4" cy="69" r="4" />
                                    <circle cx="82" cy="61" r="4" />
                                    <circle cx="164" cy="51" r="4" />
                                    <circle cx="244" cy="44" r="4" />
                                    <circle cx="316" cy="36" r="4" />
                                </g>
                            </svg>
                            <div><span>08:00</span><span>12:00</span><span>Сейчас</span></div>
                        </div>
                        <div class="sg-phone-mockup__advice">
                            <span>Подсказка</span>
                            <strong>Сахар в целевом диапазоне</strong>
                            <small>Продолжай по своему обычному плану.</small>
                        </div>
                        <div class="sg-phone-mockup__nav">
                            <span class="is-active">⌂</span><span>▥</span><span>▢</span><span>◉</span>
                        </div>
                    </div>

                    <div class="sg-dashboard-mockup">
                        <div class="sg-dashboard-mockup__top">
                            <span><i></i>SugarGuard</span>
                            <span class="sg-ui-pill">Сегодня</span>
                        </div>
                        <div class="sg-dashboard-mockup__heading">
                            <div><small>Кабинет родителя</small><strong>Обзор за сегодня</strong></div>
                            <span class="sg-ui-pill sg-ui-pill--ok">Данные синхронизированы</span>
                        </div>
                        <div class="sg-dashboard-mockup__metrics">
                            <div><small>Последний сахар</small><strong>5,8</strong><span>ммоль/л</span></div>
                            <div><small>В диапазоне</small><strong>82%</strong><span>за 7 дней</span></div>
                            <div><small>События</small><strong>1</strong><span>требует внимания</span></div>
                        </div>
                        <div class="sg-dashboard-mockup__body">
                            <div class="sg-dashboard-mockup__graph">
                                <div class="sg-dashboard-mockup__graph-head"><strong>Динамика глюкозы</strong><small>24 часа</small></div>
                                <svg viewBox="0 0 520 155" preserveAspectRatio="none">
                                    <defs>
                                        <linearGradient id="hero-area" x1="0" y1="0" x2="0" y2="1">
                                            <stop offset="0" stop-color="#17968f" stop-opacity=".22" />
                                            <stop offset="1" stop-color="#17968f" stop-opacity="0" />
                                        </linearGradient>
                                    </defs>
                                    <path class="sg-dashboard-area" d="M0 116 C55 94, 82 102, 128 82 S216 50, 268 69 S354 111, 405 72 S474 48, 520 56 L520 155 L0 155Z" />
                                    <path class="sg-chart-line" d="M0 116 C55 94, 82 102, 128 82 S216 50, 268 69 S354 111, 405 72 S474 48, 520 56" />
                                </svg>
                            </div>
                            <div class="sg-dashboard-mockup__event">
                                <span class="sg-event-icon">!</span>
                                <div><strong>Родитель уведомлён</strong><small>SOS · координаты получены</small></div>
                            </div>
                        </div>
                    </div>
                </div>
                <p class="sg-visually-hidden">
                    Демонстрация мобильного приложения с текущей глюкозой и веб-кабинета родителя с графиком и уведомлением.
                </p>
            </div>
        </section>

        <section class="sg-landing__signal-bar" aria-label="Ключевые свойства продукта">
            <div class="sg-landing__container sg-landing__signal-grid">
                <div><strong>Android 5.0+</strong><span>Мобильное приложение ребёнка</span></div>
                <div><strong>Web-кабинеты</strong><span>Родитель, врач и администратор</span></div>
                <div><strong>Офлайн-сценарии</strong><span>Записи сохраняются до синхронизации</span></div>
                <div><strong>Экспорт данных</strong><span>Отчёты для обсуждения с врачом</span></div>
            </div>
        </section>

        <section id="audiences" class="sg-section sg-section--audiences sg-reveal" aria-labelledby="audiences-title">
            <div class="sg-landing__container">
                <header class="sg-section__header">
                    <span class="sg-section__kicker">Один сервис — разные задачи</span>
                    <h2 id="audiences-title">Каждый видит только то, что нужно для его роли</h2>
                    <p>Выберите свой сценарий и посмотрите, какую ежедневную проблему решает SugarGuard.</p>
                </header>

                <div class="sg-audience-tabs" role="tablist" aria-label="Сценарии пользователей">
                    @foreach (var audience in Audiences)
                    {
                        <button id="audience-tab-@audience.Id"
                                class="@AudienceTabClass(audience.Id)"
                                type="button"
                                role="tab"
                                aria-selected="@(activeAudienceId == audience.Id ? "true" : "false")"
                                aria-controls="audience-panel"
                                @onclick="() => SelectAudience(audience.Id)">
                            <span>@audience.Number</span>
                            @audience.Label
                        </button>
                    }
                </div>

                <div id="audience-panel"
                     class="sg-audience-panel"
                     role="tabpanel"
                     aria-live="polite"
                     aria-labelledby="audience-tab-@ActiveAudience.Id">
                    <div class="sg-audience-panel__copy">
                        <span class="sg-audience-panel__eyebrow">@ActiveAudience.Eyebrow</span>
                        <h3>@ActiveAudience.Title</h3>
                        <p>@ActiveAudience.Description</p>
                        <ul role="list">
                            @foreach (var benefit in ActiveAudience.Benefits)
                            {
                                <li>
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m5 12 4 4L19 6" /></svg>
                                    @benefit
                                </li>
                            }
                        </ul>
                        <a class="sg-text-link" href="@ActiveAudience.CtaHref">@ActiveAudience.CtaLabel <span aria-hidden="true">→</span></a>
                    </div>
                    <div class="sg-audience-panel__preview" aria-hidden="true">
                        <div class="sg-role-preview__header">
                            <span>@ActiveAudience.PreviewLabel</span>
                            <i></i><i></i><i></i>
                        </div>
                        <div class="sg-role-preview__card">
                            <small>@ActiveAudience.PreviewTitle</small>
                            <strong>@ActiveAudience.PreviewMetric</strong>
                            <span>@ActiveAudience.PreviewCaption</span>
                        </div>
                        <div class="sg-role-preview__rows">
                            <span></span><span></span><span></span>
                        </div>
                    </div>
                </div>

                <aside class="sg-adult-note">
                    <span class="sg-adult-note__icon" aria-hidden="true">18+</span>
                    <div>
                        <strong>Не только для детей</strong>
                        <p>Для самостоятельного взрослого пользователя предусмотрен отдельный профиль, включая настройки для СД2. Детский сценарий при этом остаётся основным.</p>
                    </div>
                </aside>
            </div>
        </section>

        <section id="how-it-works" class="sg-section sg-section--how sg-reveal" aria-labelledby="how-title">
            <div class="sg-landing__container">
                <header class="sg-section__header sg-section__header--center">
                    <span class="sg-section__kicker">От измерения до понятного действия</span>
                    <h2 id="how-title">Как SugarGuard работает в течение дня</h2>
                    <p>Четыре шага без ручного переноса данных между телефоном, родителем и врачом.</p>
                </header>

                <ol class="sg-steps">
                    <li>
                        <span class="sg-steps__number">01</span>
                        <div class="sg-steps__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M12 3v18M5 8h8a3 3 0 0 1 0 6H8a3 3 0 0 0 0 6h11" /></svg>
                        </div>
                        <h3>Фиксируем данные</h3>
                        <p>Ребёнок вводит глюкозу и питание вручную либо получает показания из совместимого источника CGM.</p>
                    </li>
                    <li>
                        <span class="sg-steps__number">02</span>
                        <div class="sg-steps__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M20 16.5A4.5 4.5 0 0 0 17 8h-1A7 7 0 1 0 5 16.9M8 17l4 4 4-4M12 12v9" /></svg>
                        </div>
                        <h3>Сохраняем и синхронизируем</h3>
                        <p>Без сети запись остаётся на телефоне. Когда связь возвращается, очередь синхронизируется с кабинетом.</p>
                    </li>
                    <li>
                        <span class="sg-steps__number">03</span>
                        <div class="sg-steps__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M4 19V9M10 19V5M16 19v-7M22 19V3" /></svg>
                        </div>
                        <h3>Понимаем динамику</h3>
                        <p>График, целевой диапазон и контекст питания помогают увидеть тенденцию, а не отдельную цифру.</p>
                    </li>
                    <li>
                        <span class="sg-steps__number">04</span>
                        <div class="sg-steps__icon" aria-hidden="true">
                            <svg viewBox="0 0 24 24"><path d="M20 11a8 8 0 1 1-3-6.2M20 4v7h-7M8 12l3 3 5-6" /></svg>
                        </div>
                        <h3>Реагируем вместе</h3>
                        <p>Родитель получает важные уведомления, врач видит историю, а ребёнок — безопасную подсказку по ситуации.</p>
                    </li>
                </ol>

                <div class="sg-medical-note">
                    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3 2.8 20h18.4L12 3Zm0 6v5m0 3h.01" /></svg>
                    <p><strong>Важно:</strong> ИИ-подсказки носят информационный характер, не рассчитывают дозу инсулина и не заменяют консультацию врача или индивидуальный план лечения.</p>
                </div>
            </div>
        </section>

        <section class="sg-section sg-section--capabilities sg-reveal" aria-labelledby="capabilities-title">
            <div class="sg-landing__container">
                <header class="sg-section__header">
                    <span class="sg-section__kicker">Не набор функций, а ежедневные сценарии</span>
                    <h2 id="capabilities-title">Всё важное — в контексте конкретной ситуации</h2>
                </header>

                <div class="sg-capabilities-grid">
                    <article class="sg-capability sg-capability--wide">
                        <div class="sg-capability__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M3 20V4m0 16h18M7 15l4-4 3 2 5-7" /></svg></div>
                        <span class="sg-capability__label">Динамика</span>
                        <h3>Следите за глюкозой, а не за разрозненными цифрами</h3>
                        <p>День, 7 и фактические 30 дней, целевой диапазон, TIR и источник измерения помогают обсуждать с врачом полную картину.</p>
                    </article>
                    <article class="sg-capability">
                        <div class="sg-capability__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M6 8h12l-1 12H7L6 8Zm3 0V6a3 3 0 0 1 6 0v2" /></svg></div>
                        <span class="sg-capability__label">Питание</span>
                        <h3>Держите безопасный перекус под рукой</h3>
                        <p>«Рюкзак» хранит состав и ХЕ, а подсказка учитывает доступные продукты только когда это уместно.</p>
                    </article>
                    <article class="sg-capability">
                        <div class="sg-capability__icon sg-capability__icon--alert" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 3v10m0 4h.01M5 21h14a2 2 0 0 0 1.7-3L13.7 5a2 2 0 0 0-3.4 0l-7 13A2 2 0 0 0 5 21Z" /></svg></div>
                        <span class="sg-capability__label">SOS</span>
                        <h3>Передайте взрослому главное одним действием</h3>
                        <p>Экстренное сообщение включает текущую глюкозу и координаты, а на экране остаются прямые действия: родитель и 112.</p>
                    </article>
                    <article class="sg-capability">
                        <div class="sg-capability__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 3h8v4H8V3ZM5 5H3v16h18V5h-2M8 12h8m-8 4h5" /></svg></div>
                        <span class="sg-capability__label">Врач</span>
                        <h3>Дайте врачу картину без ручного сбора</h3>
                        <p>Пациенты, группы риска, заметки, аналитика и экспорт собраны в отдельном клиническом кабинете.</p>
                    </article>
                    <article class="sg-capability sg-capability--wide">
                        <div class="sg-capability__icon" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 2 4 5v6c0 5.1 3.4 9.4 8 11 4.6-1.6 8-5.9 8-11V5l-8-3Zm-3 10 2 2 4-5" /></svg></div>
                        <span class="sg-capability__label">Надёжность</span>
                        <h3>Продолжайте вести дневник даже без интернета</h3>
                        <p>Проверенная локальная сессия, зашифрованное хранение и очередь синхронизации поддерживают основные сценарии в дороге, школе и за городом.</p>
                    </article>
                </div>
            </div>
        </section>

        <section id="interface" class="sg-section sg-section--interface sg-reveal" aria-labelledby="interface-title">
            <div class="sg-landing__container">
                <header class="sg-section__header sg-section__header--split">
                    <div>
                        <span class="sg-section__kicker">Продукт уже можно увидеть</span>
                        <h2 id="interface-title">Ключевые экраны SugarGuard</h2>
                    </div>
                    <p>Обезличенные демонстрационные данные показывают реальные сценарии мобильного приложения и веб-кабинетов.</p>
                </header>

                <div class="sg-screen-gallery">
                    <article class="sg-screen-card sg-screen-card--mobile">
                        <header><span>Мобильное приложение</span><strong>Главная</strong></header>
                        <div class="sg-screen-card__canvas sg-mini-home">
                            <div class="sg-mini-title">Мой сахар</div>
                            <div class="sg-mini-glucose"><strong>5,8</strong><span>ммоль/л</span><em>В норме</em></div>
                            <svg viewBox="0 0 240 64" preserveAspectRatio="none"><path d="M2 49 C36 39, 48 50, 82 35 S132 28, 158 39 S204 14, 238 22" /></svg>
                            <span class="sg-mini-action">Получить подсказку</span>
                        </div>
                    </article>

                    <article class="sg-screen-card">
                        <header><span>Мобильное приложение</span><strong>История</strong></header>
                        <div class="sg-screen-card__canvas sg-mini-history">
                            <div class="sg-mini-tabs"><b>Сегодня</b><span>7 дней</span><span>30 дней</span></div>
                            <div class="sg-mini-chart-zone"></div>
                            <svg viewBox="0 0 300 100" preserveAspectRatio="none"><path d="M2 70 C45 61, 62 79, 99 52 S157 34, 190 47 S247 30, 298 38" /></svg>
                            <div class="sg-mini-legend"><span>В диапазоне 82%</span><span>Среднее 6,4</span></div>
                        </div>
                    </article>

                    <article class="sg-screen-card">
                        <header><span>Мобильное приложение</span><strong>Рюкзак</strong></header>
                        <div class="sg-screen-card__canvas sg-mini-backpack">
                            <div><strong>Быстрые перекусы</strong><span>6 позиций · 10,0 ХЕ</span></div>
                            <ul role="presentation"><li><i>🥤</i><span><b>Сок 200 мл</b><small>2,0 ХЕ · 4 шт.</small></span></li><li><i>🍎</i><span><b>Яблоко</b><small>1,0 ХЕ · 2 шт.</small></span></li></ul>
                        </div>
                    </article>

                    <article class="sg-screen-card sg-screen-card--wide">
