# Заполните только параметрами фактически установленного Happ.
# Не добавляйте сюда ссылку подписки, токен Telegram или пароль.

# Локальный proxy, включённый Happ. Поддерживаются http://, https://, socks5://, socks5h://.
# Укажите реальный порт из настроек Happ. Пример намеренно не содержит предположений о порте.
HAPP_PROXY_URL=

# Systemd unit, который действительно запускает Happ на этом сервере.
# Оставьте пустым, пока не создан устойчивый unit. Watchdog не будет угадывать путь к Happ.
HAPP_SERVICE=

# Сервис SugarGuard Telegram-бота.
BOT_SERVICE=sugarguard-bot.service

# Статус VPN передаётся напрямую в SugarGuard API через существующий
# /etc/sugarguard-bot.env. Не добавляйте сюда BOT_SERVICE_AUTH_KEY: watchdog
# получает его только из закрытого systemd EnvironmentFile.

# Два последовательных неуспешных прогона до попытки восстановления.
FAILURE_THRESHOLD=2

# Защита от цикла перезапусков, в секундах.
RECOVERY_COOLDOWN_SECONDS=300

# Пауза после рестарта Happ до проверки Telegram и рестарта бота.
RESTART_SETTLE_SECONDS=8

# Ограничения одного сетевого запроса.
CONNECT_TIMEOUT_SECONDS=8
MAX_TIME_SECONDS=15
