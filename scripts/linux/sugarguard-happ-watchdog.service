[Unit]
Description=SugarGuard: проверка доступа Telegram через локальный proxy Happ
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/sugarguard/happ-telegram-watchdog.env

[Service]
Type=oneshot
User=root
Group=root
EnvironmentFile=-/etc/sugarguard/happ-telegram-watchdog.env
ExecStart=/usr/local/libexec/sugarguard/happ-telegram-watchdog.sh
# Код 1 означает недоступный в данный момент маршрут, а не сбой самого watchdog.
SuccessExitStatus=1

# Watchdog не хранит секретов и пишет только своё состояние.
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sugarguard-happ-watchdog /run
UMask=0027

[Install]
WantedBy=multi-user.target
